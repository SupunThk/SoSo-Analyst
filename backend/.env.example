PORT=3001
NODE_ENV=development
SOSO_API_KEY=your_sosovalue_key
GEMINI_API_KEY=your_gemini_key
ETHERSCAN_API_KEY=your_etherscan_key
SODEX_API_KEY=your_sodex_api_key_name
MONGO_URI=your_mongodb_connection_string
CORS_ORIGIN=http://localhost:3000
SOSO_REQUEST_TIMEOUT_MS=15000
# SoSoValue allows 20 requests/min and 100k/month per key. A 429 asking to wait
# longer than this (ms) fails fast and serves cached data instead of stalling.
SOSO_MAX_RETRY_WAIT_MS=5000
GEMINI_REQUEST_TIMEOUT_MS=60000
ETHERSCAN_REQUEST_TIMEOUT_MS=15000
OPENOCEAN_REQUEST_TIMEOUT_MS=15000
SODEX_REQUEST_TIMEOUT_MS=15000
SODEX_NETWORK=mainnet
SODEX_REST_BASE_URL=https://mainnet-gw.sodex.dev/api/v1
# In-app trading. It turns on when SODEX_BUILDER_ID is set, or earlier with
# SODEX_TRADING_ENABLED=true (orders then carry no builder code; once the ID
# is set, users approve the builder with one more signature). The builder account needs >= 100 vUSDC in
# Spot and in Perps on the selected network. For testnet use
# SODEX_NETWORK=testnet and SODEX_REST_BASE_URL=https://testnet-gw.sodex.dev/api/v1
SODEX_TRADING_ENABLED=false
SODEX_BUILDER_ID=
SODEX_BUILDER_ADDRESS=
# Builder fee in tenths of a basis point (50 = 0.05%). Perps cap is 200.
SODEX_BUILDER_FEE=50
SODEX_MAX_ORDER_NOTIONAL_USD=1000
SODEX_MAX_LEVERAGE=10
TRADING_RATE_LIMIT_PER_MINUTE=30
ETHERSCAN_CHAIN_IDS=1,8453,56,137,42161,10,43114
ETHERSCAN_TOKEN_TRANSFER_OFFSET=100
ETHERSCAN_TOKENS_PER_CHAIN=12
AGENT_RATE_LIMIT_PER_MINUTE=20
# Free chat questions per IP per day for signed-out visitors (0 = sign-in required)
GUEST_CHAT_DAILY_LIMIT=3
CHAT_RATE_LIMIT_PER_MINUTE=60
SYSTEM_PROMPT_VERSION=v3
GEMINI_TOOL_PAYLOAD_MAX_CHARS=12000

# Optional model / feature switches (defaults shown)
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro
# GEMINI_MODEL_LIGHT=gemini-2.5-flash
# GEMINI_MODEL_SEARCH=gemini-2.5-flash
# GEMINI_GOOGLE_SEARCH=on
# LLM_INTENT_CLASSIFIER=on
